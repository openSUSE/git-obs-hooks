#!/usr/bin/python3

"""
Custom Git LFS hook that enforces .gitattributes:
It rejects files that should be in LFS based on .gitattributes
but were committed as regular Git objects and vice-versa.

It does NOT verify the integrity of LFS objects on disk.
"""

import os
import subprocess
import sys
from typing import Dict, List, Optional, Set
from osc.gitea_api import Git

sys.dont_write_bytecode = True


def debug_msg(msg: str) -> None:
    if os.environ.get("GIT_OBS_HOOKS_DEBUG") == "1":
        print(f"DEBUG: {msg}", file=sys.stderr)


def verbose_msg(msg: str) -> None:
    if os.environ.get("GIT_OBS_HOOKS_DEBUG") == "1" or os.environ.get("GIT_OBS_HOOKS_VERBOSE") == "1":
        print(f"VERBOSE: {msg}", file=sys.stderr)


def has_lfs_attribute(content: bytes) -> bool:
    for line in content.splitlines():
        line = line.strip()
        if line and not line.startswith(b"#") and b"filter=lfs" in line.split():
            return True
    return False


def is_lfs_pointer(content: bytes) -> bool:
    """Check for the expected Git LFS pointer header and required fields."""
    lines = content.splitlines()
    if len(lines) < 3 or lines[0] != b"version https://git-lfs.github.com/spec/v1":
        return False

    has_oid = any(line.startswith(b"oid sha256:") for line in lines[1:])
    has_size = any(line.startswith(b"size ") for line in lines[1:])
    return has_oid and has_size


def is_revision_allowlisted(sha: str, allowlisted_revisions: Set[str]) -> bool:
    """Check if a revision is listed in the configured allowlist."""
    return bool(sha) and sha.lower() in allowlisted_revisions


class LfsChecker:
    def __init__(self, git: Git):
        self.git = git
        self.cache: Dict = {}

    def get_allowlisted_revisions(self) -> Set[str]:
        """Return allowlisted revision hashes from the configured allowlist file."""
        proc = subprocess.run(["git", "config", "git-obs-hooks.lfsAllowlistedRevisionFile"], cwd=self.git.abspath, stdout=subprocess.PIPE, text=True, check=False)
        path = proc.stdout.strip()
        if not path or not os.path.isfile(path):
            return set()

        with open(path, "r", encoding="utf-8", errors="replace") as f:
            return {line.split()[0].lower() for line in f if line.strip() and not line.strip().startswith("#")}

    def get_attributes(self, rev: str, paths: List[str]) -> Dict[str, str]:
        """Query git check-attr for the 'filter' attribute."""
        if not paths:
            return {}

        with subprocess.Popen(
            ["git", "check-attr", "-z", "--source", rev, "--stdin", "filter"],
            cwd=self.git.abspath,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        ) as proc:
            stdin_data = b"\0".join(p.encode("utf-8", "surrogateescape") for p in paths) + b"\0"
            stdout, stderr = proc.communicate(input=stdin_data)
            if proc.returncode != 0:
                details = stderr.decode("utf-8", "replace").strip() or "unknown git check-attr failure"
                raise RuntimeError(f"git check-attr failed for revision {rev}: {details}")

        results = {}
        tokens = stdout.split(b"\0")
        if tokens and tokens[-1] == b"":
            tokens.pop()

        if len(tokens) % 3 != 0:
            raise RuntimeError(f"Malformed output from git check-attr: expected multiple of 3 tokens, got {len(tokens)}")

        for i in range(0, len(tokens), 3):
            raw_path, _, raw_value = tokens[i : i + 3]
            path = raw_path.decode("utf-8", "surrogateescape")
            value = raw_value.decode("utf-8", "replace")
            results[path] = value
        return results

    def get_changed_blobs(self, commits: List[str]) -> Dict[str, Set[str]]:
        """Return added or modified object hashes mapped to their commits."""
        result: Dict[str, Set[str]] = {}

        with subprocess.Popen(
            ["git", "diff-tree", "--stdin", "--root", "-r", "--raw", "--no-abbrev", "--no-renames", "--diff-filter=AM", "-m"],
            cwd=self.git.abspath,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=sys.stderr,
            encoding="utf-8",
        ) as proc:
            stdout, _ = proc.communicate(input="\n".join(commits) + "\n")
            if proc.returncode != 0:
                raise RuntimeError("git diff-tree failed while searching for LFS pointer blobs")

        current_rev = None
        for line in stdout.splitlines():
            if not line:
                continue
            if not line.startswith(":"):
                current_rev = line
                continue
            if current_rev is None:
                raise RuntimeError(f"Malformed git diff-tree output: '{line}'")

            fields = line.split(None, 5)
            if len(fields) < 5:
                raise RuntimeError(f"Malformed git diff-tree output: '{line}'")
            result.setdefault(fields[3], set()).add(current_rev)

        return result

    def get_blob_sizes(self, object_hashes) -> Dict[str, int]:
        """Return sizes for existing blob objects."""
        if not object_hashes:
            return {}

        result: Dict[str, int] = {}
        stdout = subprocess.check_output(
            ["git", "cat-file", "--batch-check=%(objectname) %(objecttype) %(objectsize)"],
            cwd=self.git.abspath,
            stderr=sys.stderr,
            encoding="utf-8",
            input="\n".join(object_hashes) + "\n",
        )
        for line in stdout.splitlines():
            parts = line.split()
            if len(parts) == 2 and parts[1] == "missing":
                continue
            if len(parts) != 3:
                raise RuntimeError(f"Malformed git cat-file output: '{line}'")
            object_hash, object_type, object_size = parts
            if object_type == "blob":
                result[object_hash] = int(object_size)

        return result

    def cache_pointers(self, object_hashes, hash_to_size: Dict[str, int]) -> None:
        """Cache whether the provided blob hashes contain LFS pointers."""
        to_check = []
        for object_hash in set(object_hashes):
            if object_hash in self.cache:
                continue

            size = hash_to_size.get(object_hash, 0)
            if size < 50 or size > 1024:
                self.cache[object_hash] = False
                continue

            to_check.append(object_hash)

        if not to_check:
            return

        # Binary mode is required: blobs may contain non-UTF-8 bytes and git
        # reports object sizes in bytes, so offsets must be byte offsets.
        with subprocess.Popen(
            ["git", "cat-file", "--batch"],
            cwd=self.git.abspath,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=sys.stderr,
            bufsize=1024 * 1024,
        ) as proc:
            stdout_stream, _ = proc.communicate(input=("\n".join(to_check) + "\n").encode("utf-8"))
            if proc.returncode != 0:
                raise RuntimeError("git cat-file --batch failed")

        offset = 0
        for object_hash in to_check:
            newline_idx = stdout_stream.find(b"\n", offset)
            if newline_idx == -1:
                raise RuntimeError(f"git cat-file output truncated, expected object {object_hash}")

            header = stdout_stream[offset:newline_idx].decode("utf-8")
            parts = header.split()
            if len(parts) == 2 and parts[1] == "missing":
                self.cache[object_hash] = False
                offset = newline_idx + 1
                continue

            if len(parts) != 3:
                raise RuntimeError(f"Malformed git cat-file header: '{header}'")

            try:
                size = int(parts[2])
            except ValueError:
                raise RuntimeError(f"Malformed object size in git cat-file header: '{header}'")

            content_start = newline_idx + 1
            content_end = content_start + size
            if content_end > len(stdout_stream):
                raise RuntimeError(f"git cat-file output truncated for object {object_hash}")

            self.cache[object_hash] = is_lfs_pointer(stdout_stream[content_start:content_end])
            offset = content_end + 1

    def verify_blobs(self, rev: str, file_to_hash: Dict[str, str], hash_to_size: Dict[str, int], attrs: Dict[str, str], allowlisted_revisions: Optional[Set[str]] = None):
        """Verify LFS compliance for a set of files."""
        self.cache_pointers(file_to_hash.values(), hash_to_size)

        # validation phase
        errors = []
        for path, h in file_to_hash.items():
            should_be_lfs = attrs.get(path) == "lfs"
            is_lfs = self.cache.get(h, False)

            if (should_be_lfs and not is_lfs) or (not should_be_lfs and is_lfs):
                if allowlisted_revisions:
                    cache_key = (path, h)
                    if cache_key not in self.cache:
                        origin = subprocess.run(["git", "log", "-1", "--format=%H", rev, "--", path], cwd=self.git.abspath, stdout=subprocess.PIPE, text=True, check=False).stdout.strip()
                        self.cache[cache_key] = is_revision_allowlisted(origin, allowlisted_revisions)
                    if self.cache[cache_key]:
                        verbose_msg(f"skipping {path} in {rev}: allowlisted origin")
                        continue

                if should_be_lfs and not is_lfs:
                    errors.append(f"  - {path}: matches LFS attribute but is NOT an LFS pointer")
                else:
                    errors.append(f"  - {path}: is NOT matched by LFS attribute but IS an LFS pointer")

        if errors:
            print(f"LFS compliance errors in revision {rev}:", file=sys.stderr)
            for err in errors:
                print(err, file=sys.stderr)
            return False
        return True

    def check_revision(self, rev: str, allowlisted_revisions: Optional[Set[str]] = None) -> bool:
        """Check if the specified revision is LFS compliant."""
        with subprocess.Popen(
            ["git", "ls-tree", "-z", "-r", "--long", rev],
            cwd=self.git.abspath,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        ) as proc:
            stdout, stderr = proc.communicate()
            if proc.returncode != 0:
                details = stderr.decode("utf-8", "replace").strip() or "unknown git ls-tree failure"
                raise RuntimeError(f"git ls-tree failed for revision {rev}: {details}")

        file_to_hash = {}
        hash_to_size = {}
        for entry in stdout.split(b"\0"):
            if not entry:
                continue
            meta, raw_path = entry.split(b"\t", 1)
            mode, _, blob_hash, raw_size = meta.split()
            if mode.startswith(b"100"):
                path = raw_path.decode("utf-8", "surrogateescape")
                h = blob_hash.decode("ascii")
                file_to_hash[path] = h
                hash_to_size[h] = int(raw_size)

        if not file_to_hash:
            return True

        attrs = self.get_attributes(rev, list(file_to_hash.keys()))
        return self.verify_blobs(rev, file_to_hash, hash_to_size, attrs, allowlisted_revisions)

    def commits_with_lfs_attributes(self, commits: List[str]) -> Set[str]:
        """Return commits whose .gitattributes enables git-lfs (contains 'filter=lfs')."""
        if not commits:
            return set()

        commits_to_check = set()
        blob_has_lfs = {}
        stdout = subprocess.check_output(
            ["git", "cat-file", "--batch-check=%(objectname) %(objecttype)"],
            cwd=self.git.abspath,
            stderr=subprocess.DEVNULL,
            encoding="utf-8",
            input="\n".join(f"{rev}:.gitattributes" for rev in commits) + "\n",
        )
        for rev, line in zip(commits, stdout.splitlines()):
            objectname, objecttype = line.split()
            if objecttype != "blob":
                continue

            if objectname not in blob_has_lfs:
                content = subprocess.check_output(
                    ["git", "cat-file", "blob", objectname],
                    cwd=self.git.abspath,
                    stderr=subprocess.DEVNULL,
                )
                blob_has_lfs[objectname] = has_lfs_attribute(content)

            if blob_has_lfs[objectname]:
                commits_to_check.add(rev)

        return commits_to_check

    def commits_with_lfs_pointer_changes(self, commits: List[str]) -> Set[str]:
        """Return commits that add or modify an LFS pointer blob."""
        blobs = self.get_changed_blobs(commits)
        sizes = self.get_blob_sizes(blobs)
        self.cache_pointers(sizes.keys(), sizes)
        return {
            rev
            for object_hash, revisions in blobs.items()
            if self.cache.get(object_hash, False)
            for rev in revisions
        }


def main():
    git = Git(".")
    checker = LfsChecker(git)
    seen = set()
    success = True

    allowlisted_revisions = checker.get_allowlisted_revisions()
    try:
        for old_rev, new_rev, _ref_name in git.parse_githook_stdin():
            commits = git.get_commit_range(old_rev, new_rev, not_all=True)
            commits = [sha for sha in commits if sha not in seen]
            commits_to_check = checker.commits_with_lfs_attributes(commits) | checker.commits_with_lfs_pointer_changes(commits)
            for sha in commits:
                if is_revision_allowlisted(sha, allowlisted_revisions):
                    verbose_msg(f"skipping revision {sha}: allowlisted")
                    continue

                if sha in commits_to_check:
                    debug_msg(f"checking LFS compliance for revision {sha}")
                    success &= checker.check_revision(sha, allowlisted_revisions)
                else:
                    verbose_msg(f"skipping LFS compliance check for revision {sha} (no LFS rule or pointer)")
            seen.update(commits)
    except RuntimeError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        sys.exit(1)

    if not success:
        sys.exit(1)


if __name__ == "__main__":
    main()
